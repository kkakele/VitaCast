# VitaCast .gitignore

# Archivos de compilación
*.o
*.elf
*.velf
*.self
eboot.bin
param.sfo

# VPK (excepto releases)
*.vpk

# Directorios de build temporales
build/
temp_vpk*/
_vpk_build/
_assets_tmp/

# Logs y debugging
*.log
debug/
*.dmp

# Assets temporales (mantener originales en sce_sys)
*.psd
*.xcf
*.ai
*.sketch

# IDE y editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Backup files
*.bak
*.backup
*~

# Dependencias (si se usan)
node_modules/
vendor/

# Archivos de configuración personal
.env
config.local.*

# Compilación de Windows
*.exe
*.dll
*.lib
*.obj

# Core dumps
core
core.*

# Tests
test_output/
*.test

# Documentación generada
docs/generated/
html/
latex/

# Mantener estructura de directorios vacíos
!.gitkeep
